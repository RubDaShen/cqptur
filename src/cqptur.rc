#include <windows.h>

#include "resource.h"

//  The first icon also becomes the .exe's icon in Explorer.
IDI_APP ICON "../res/cqptur.ico"

//  Shown in the file's Properties, and used by Windows to name cqptur in notifications
//  and in Task Manager's Startup apps page.
VS_VERSION_INFO VERSIONINFO
    FILEVERSION CQPTUR_VERSION_NUMBERS
    PRODUCTVERSION CQPTUR_VERSION_NUMBERS
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
    FILEFLAGS 0
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
    FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RubDaShen"
            VALUE "FileDescription", "cqptur"
            VALUE "FileVersion", CQPTUR_VERSION_STRING
            VALUE "InternalName", "cqptur"
            VALUE "LegalCopyright", "Copyright (c) 2026 RubDaShen"
            VALUE "OriginalFilename", "cqptur.exe"
            VALUE "ProductName", "cqptur"
            VALUE "ProductVersion", CQPTUR_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
